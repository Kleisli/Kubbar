prototype(Kleisli.Kubbar:Component.ContentCollectionGrid) < prototype(Neos.Fusion:Component) {

    cols = 1
    gap = 4

    renderer = Neos.Neos:ContentCollection {
        attributes.class = ${"grid grid-cols-" + props.cols + " gap-" + props.gap}
    }

    //
    dummy = "grid-cols-1 grid-cols-2 grid-cols-3 grid-cols-4 gap-2 gap-4 gap-6 gap-8"
}
