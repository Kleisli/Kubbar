prototype(Kleisli.Kubbar:Page.Navigation.Menu) < prototype(Neos.Fusion:Component) {

    attributes = Neos.Fusion:DataStructure {
        class = "border-1 lg:p-4"
    }

    menuButton = Kleisli.Kubbar:Page.Navigation.Menu.MenuButton

    menu = Neos.Neos:Menu {
        startingPoint = ${site}
        maximumLevels = 2
        renderer = Kleisli.Kubbar:Page.Navigation.Menu.MenuItemListRenderer
    }

    renderer = afx`
        <nav x-data="{open: false}" {...props.attributes}>
            <div class="lg:hidden flex justify-end">
                {props.menuButton}
            </div>
            {props.menu}
        </nav>
    `
}
