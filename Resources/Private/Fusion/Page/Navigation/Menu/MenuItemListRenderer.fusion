prototype(Kleisli.Kubbar:Page.Navigation.Menu.MenuItemListRenderer) < prototype(Neos.Fusion:Component) {

    class = "flex flex-col justify-center gap-2 text-xl mx-auto lg:flex lg:flex-row lg:text-center"
    liClass = "text-xl mr-2 align-middle"
    items = ${private.items}
    level = 0

    renderer = afx`
        <menu class={props.class} x-bind:class="{'hidden': !open}">
            <Neos.Fusion:Loop items={props.items} itemName="item">
                <li class={'group relative ' + props.liClass + ' ' + item.state.value}>
                    <Neos.Fusion:Tag tagName={item.uri ? 'a' : 'span'} attributes.href={item.uri} attributes.title={item.label}>
                        {item.label}
                    </Neos.Fusion:Tag>
                    <Kleisli.Kubbar:Page.Navigation.Menu.SubMenuItemListRenderer @if={item.children} items={item.children} level={1} />
                </li>
            </Neos.Fusion:Loop>
        </menu>
    `
}
