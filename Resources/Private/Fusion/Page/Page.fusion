##
# This prototypes object are sequenctially rendered as strings
# and output to form the the html response.
#
# For all the base data, see Neos.Neos:Page
##
prototype(Kleisli.Kubbar:Page) < prototype(Neos.Neos:Page) {

    head {
        metaTags = afx`
            <meta http-equiv="x-ua-compatible" content="ie=edge" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        `
    }

    bodyTag {
        attributes.class = "flex flex-col justify-between min-h-screen"
    }

    body = Kleisli.Kubbar:Page.Template
}
